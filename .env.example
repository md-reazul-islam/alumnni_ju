APP_NAME="University Alumni Network"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alumni.yourdomain.edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL 8 connection. On Hostinger, create the database and a dedicated
# database user from hPanel > Databases > MySQL Databases first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alumni_management
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Sessions and cache are stored in the database (see the `sessions` and
# `cache` tables created by the framework migrations) so no extra services
# (Redis/Memcached) are required to run this application.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Required for password resets, verification emails, contact form, and
# donation/event/job notification emails. Hostinger provides SMTP
# credentials under hPanel > Emails, or use a transactional provider
# (Postmark, Mailgun, SES, Resend) for higher deliverability.
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourdomain.edu
MAIL_PORT=587
MAIL_USERNAME=alumni@yourdomain.edu
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alumni@yourdomain.edu"
MAIL_FROM_NAME="${APP_NAME}"

# Only required if FILESYSTEM_DISK=s3 is used instead of local/public storage
# for uploaded profile photos, resumes, and event/news images.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The donation module ships with a PaymentGatewayInterface abstraction
# (see app/Services/Payment) bound to a manual/offline gateway by default.
# Set these and swap the binding in AppServiceProvider to a StripeGateway
# implementation when ready to accept live card payments.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=


# Powers the "Site Assistant" chat widget (bottom-right on public pages).
# Get a key from https://console.anthropic.com/ — without it, the widget
# tells visitors it isn't configured yet instead of erroring.
ANTHROPIC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
